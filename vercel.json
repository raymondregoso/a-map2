{
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/geocode.js": { "maxDuration": 60 },
    "api/claude.js": { "maxDuration": 120 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
